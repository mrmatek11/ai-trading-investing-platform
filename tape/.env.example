# Skopiuj do .env (plik .env jest w .gitignore) i uzupełnij.
POSTGRES_PASSWORD=zmien-mnie-na-dlugie-losowe-haslo

# Logowanie (Clerk) — puste = tryb jednego użytkownika
VITE_CLERK_PUBLISHABLE_KEY=
TAPE_AUTH_JWKS_URL=
TAPE_AUTH_ISSUER=
TAPE_AUTH_AUTHORIZED_PARTIES=
TAPE_ADMIN_SUBS=

# Tryb jednego użytkownika wystawiony do internetu: ustaw stały token
TAPE_API_TOKEN=

# AI serwera (brief, klasyfikacja newsów, fallback dla użytkowników bez własnego klucza):
# Claude (ANTHROPIC_API_KEY) albo DeepSeek (DEEPSEEK_API_KEY) — Claude ma pierwszeństwo
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Szyfrowanie tokenów brokerów (IBKR Flex). Wygeneruj:
#   python -c "import os,base64;print('k1:'+base64.b64encode(os.urandom(32)).decode())"
# Rotacja: dopisz nowy klucz NA POCZĄTKU (k2:…,k1:…); starego nie usuwaj, dopóki sekrety nie zostaną przepięte.
TAPE_SECRET_KEYS=

# Ceny XAU/XAG: twelvedata | oanda | goldapi (puste = tylko ceny wgrane ręcznie)
# Darmowe/demo plany są do testów — produkcja wymaga licencji dostawcy na wyświetlanie cen klientom.
TAPE_PRICE_PROVIDER=
TWELVEDATA_API_KEY=
OANDA_TOKEN=
OANDA_ENV=practice

# Kalendarz makro: puste = tylko daty FOMC z kodu; forexfactory = nieoficjalny tygodniowy JSON (do testów)
TAPE_CALENDAR_FEED=

# E-mail (raport tygodniowy, alerty prop): dowolny SMTP z STARTTLS, np. Resend, Postmark, Amazon SES
TAPE_SMTP_HOST=
TAPE_SMTP_PORT=587
TAPE_SMTP_USER=
TAPE_SMTP_PASSWORD=
TAPE_MAIL_FROM=
TAPE_APP_URL=

# Logowanie przez Discord (Discord Developer Portal → Applications → OAuth2)
# Redirect URL w Discordzie: <TAPE_APP_URL>/api/auth/discord/callback
TAPE_DISCORD_CLIENT_ID=
TAPE_DISCORD_CLIENT_SECRET=
# Wygeneruj: python -c "import secrets;print(secrets.token_urlsafe(48))"
TAPE_SESSION_SECRET=

# 1 = funkcje AI tylko na własnych kluczach użytkowników (Ustawienia → Twój klucz AI)
TAPE_AI_REQUIRE_USER_KEY=

# Kanały RSS dla newsów: "nazwa|https://adres|filtr;…" (filtr 1 = tylko wpisy o metalach/Fed/USD). Puste = domyślne
TAPE_RSS_FEEDS=

# Poranny brief (dni robocze): godzina i strefa
TAPE_BRIEF_TIME=07:30
TAPE_BRIEF_TZ=Europe/Warsaw
# Bot Telegram (@BotFather → /newbot). Użytkownicy łączą czat linkiem z aplikacji.
TAPE_TELEGRAM_BOT_TOKEN=
TAPE_TELEGRAM_BOT_USERNAME=
# Opcjonalny kanał publiczny (bot jako administrator kanału), np. @goldtape_brief, i link do niego dla użytkowników
TAPE_TELEGRAM_CHAT_ID=
TAPE_TELEGRAM_CHANNEL_URL=
